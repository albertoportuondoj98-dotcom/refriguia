<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.refriguia.app">
    <uses-permission android:name="android.permission.VIBRATE" />
    <application android:label="RefriGuía" android:icon="@mipmap/ic_launcher" android:allowBackup="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" android:hardwareAccelerated="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".Archivos" android:authorities="com.refriguia.app.archivos"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
